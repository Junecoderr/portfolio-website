<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions for the PyInstaller-built tb and tblaunch
  (packaging/macos/sign.py). Notarisation requires the hardened runtime.
  - allow-unsigned-executable-memory: ctypes callbacks (libffi closures) and
    Tk need writable+executable memory.
  - disable-library-validation: the frozen Python loads its extension modules
    and Tcl/Tk from _internal/; `tb build` copies tb next to user apps.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
