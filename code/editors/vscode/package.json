{
  "name": "tb-vscode",
  "displayName": "TB Language",
  "description": "Syntax highlighting, snippets, formatting, checks and the language server for TB (.tb files).",
  "version": "3.1.0",
  "publisher": "tb-lang",
  "license": "MIT",
  "icon": "images/icon.png",
  "homepage": "https://code.tanisha.ceo",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "tb",
    "tb-lang",
    "language",
    "security"
  ],
  "main": "./client/extension.js",
  "activationEvents": [
    "onLanguage:tb",
    "workspaceContains:**/*.tb",
    "workspaceContains:tb.toml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The language server, Run File, Format and Check run the `tb` program from tb.path. In an untrusted workspace a workspace-level tb.path is ignored."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "tb",
        "aliases": [
          "TB",
          "tb"
        ],
        "extensions": [
          ".tb"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/icon.png",
          "dark": "./images/icon.png"
        }
      },
      {
        "id": "toml",
        "filenames": [
          "tb.toml",
          "tb.lock"
        ]
      }
    ],
    "grammars": [
      {
        "language": "tb",
        "scopeName": "source.tb",
        "path": "./syntaxes/tb.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tb",
        "path": "./snippets/tb.json"
      }
    ],
    "commands": [
      {
        "command": "tb.runFile",
        "title": "TB: Run File",
        "icon": "$(play)"
      },
      {
        "command": "tb.format",
        "title": "TB: Format"
      },
      {
        "command": "tb.check",
        "title": "TB: Check"
      },
      {
        "command": "tb.test",
        "title": "TB: Run Tests"
      },
      {
        "command": "tb.restartServer",
        "title": "TB: Restart Language Server"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "tb.runFile",
          "when": "resourceLangId == tb",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "tb.runFile",
          "when": "resourceLangId == tb",
          "group": "tb@1"
        },
        {
          "command": "tb.check",
          "when": "resourceLangId == tb",
          "group": "tb@2"
        },
        {
          "command": "tb.format",
          "when": "resourceLangId == tb",
          "group": "tb@3"
        }
      ],
      "commandPalette": [
        {
          "command": "tb.runFile",
          "when": "resourceLangId == tb"
        },
        {
          "command": "tb.format",
          "when": "resourceLangId == tb"
        },
        {
          "command": "tb.check",
          "when": "resourceLangId == tb"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tb.runFile",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "resourceLangId == tb && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "TB",
      "properties": {
        "tb.path": {
          "type": "string",
          "default": "tb",
          "description": "The `tb` program to use (a name on PATH or a full path).",
          "scope": "machine-overridable"
        },
        "tb.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start `tb lsp` for diagnostics, completion, hover and go-to-definition. Needs TB 3.0 or newer; highlighting works without it."
        },
        "tb.languageServer.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments for `tb lsp`."
        },
        "tb.check.onSave": {
          "type": "boolean",
          "default": false,
          "description": "Run `tb check` on the file every time you save (only when the language server isn't running)."
        },
        "tb.run.saveBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Save the file before TB: Run File."
        },
        "tb.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the messages between VS Code and `tb lsp` (for debugging the server)."
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package --out tb-vscode-3.1.0.vsix --allow-missing-repository",
    "lint": "node --check client/extension.js && node -e \"for (const f of ['package.json','language-configuration.json','syntaxes/tb.tmLanguage.json','snippets/tb.json']) JSON.parse(require('fs').readFileSync(f, 'utf8'))\""
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1"
  }
}
