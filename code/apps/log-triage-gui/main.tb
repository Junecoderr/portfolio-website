# TB Log Triage: open a log, let TB work out its format, run the detection
# rules from apps/log-triage/rules.tb (brute force, port scans, web attacks,
# new accounts, cleared logs...) and look through the alerts. Export an HTML
# report to share with your team.
# Run: tb apps/log-triage-gui/main.tb [log file] [--light]

import gui
import logs
import report
import fs
import os
import re
import encode
import time
import "../log-triage/rules.tb" as rules

let DATA = fs.join(fs.here(), "..", "data")
let SAMPLES = [
  "auth.log",
  "access.log",
  "firewall.log",
  "windows_security.json",
  "windows_security.csv",
]

let current = nil     # path of the open log
let format = ""
let records = []
let alerts = []

let theme = "dark"
let start = fs.join(DATA, "auth.log")
for arg in os.args {
  if arg == "--light" {
    theme = "light"
  } else if arg == "--dark" {
    theme = "dark"
  } else {
    start = arg
  }
}

let win = gui.window("TB Log Triage", {"width": 1080, "height": 780, "theme": theme})

let top = win.row()
let heading = top.column({"expand": true})
heading.label("TB Log Triage", {"style": "title"})
let subtitle = heading.label("Open a log to look for trouble.", {"style": "muted"})

let bar = win.row()
bar.button(
  "Open log…",
  fn() {
    open_log()
  },
  {"primary": true},
)
bar.label("or try a sample:", {"style": "muted"})
let sample = bar.select(SAMPLES, {
  "on_change": fn(name) {
    load(fs.join(DATA, name))
  },
  "width": 22,
})
bar.button("Export HTML report…", fn() {
  export_report()
})

let counts = win.label(" ", {"style": "heading"})

# Two pages: the alerts themselves, and charts that sum them up.
let tabs = win.tabs(["Alerts", "Overview"], {"expand": true})
let page = tabs.page("Alerts")

let table = page.table(["Level", "Rule", "By", "Count", "First seen", "Last seen"], {
  "widths": [100, 330, 140, 70, 180, 180],
  "height": 6,
  "on_select": fn(row, i) {
    show_details(i)
  },
})

page.label("Details", {"style": "heading"})
let details = page.textarea({"readonly": true, "mono": true, "height": 10})

let LEVELS = ["critical", "high", "medium", "low", "informational"]
let overview = tabs.page("Overview")
let charts = overview.row({"expand": true})
let level_chart = charts.chart({
  "type": "bar",
  "title": "Alerts by level",
  "labels": LEVELS,
  "data": [0, 0, 0, 0, 0],
  "expand": true,
})
let rule_chart = charts.chart({
  "type": "pie",
  "title": "Alerts by rule",
  "empty": "No alerts",
  "expand": true,
})
let timeline = overview.chart({
  "type": "line",
  "title": "Log records per hour",
  "empty": "No timestamps",
  "expand": true,
})
let status = win.status("")

win.menu({
  "File": {
    "Open log…": fn() {
      open_log()
    },
    "Export HTML report…": fn() {
      export_report()
    },
    "-": nil,
    "Quit": win.close,
  },
})
win.key("Mod+O", fn() {
  open_log()
})
win.key("Mod+E", fn() {
  export_report()
})

let ICON = {"critical": "●●●●", "high": "●●●", "medium": "●●", "low": "●", "informational": "·"}

fn by_text(alert) {
  if alert.by == nil {
    return "-"
  }
  return str(alert.by)
}

fn level_counts() {
  let found = {"critical": 0, "high": 0, "medium": 0, "low": 0, "informational": 0}
  for a in alerts {
    found[a.level] += 1
  }
  return found
}

fn load(path) {
  try {
    let fmt = logs.sniff(path)
    let got = logs.read(path)
    records = got
    format = fmt
    current = path
  } catch err {
    gui.alert(err.message, "Couldn't read the log")
    return
  }
  alerts = rules.triage(records)
  let rows = []
  for a in alerts {
    rows.push([a.level.upper(), a.rule, by_text(a), a.count, a.first_when, a.last_when])
  }
  table.set_rows(rows)
  subtitle.set(f"{fs.name(current)}  ·  {format} format  ·  {len(records)} records")
  let c = level_counts()
  if len(alerts) == 0 {
    counts.set("No alerts. This log looks quiet.")
    counts.style("success")
    details.set("Nothing matched the rules. That's good news!")
  } else {
    counts.set(
      f"{len(alerts)} alerts:  {c.critical} critical,  {c.high} high,  {c.medium} medium,  {c.low + c.informational} low",
    )
    if c.critical + c.high > 0 {
      counts.style("danger")
    } else {
      counts.style("heading")
    }
    table.select(0)
    show_details(0)
  }
  update_charts(c)
  status.set(f"{len(records)} records  ·  {time_span()}  ·  {len(alerts)} alerts")
  win.title(f"{fs.name(current)} - TB Log Triage")
}

# Redraw the Overview page from the current alerts and records.
fn update_charts(c) {
  level_chart.update({
    "data": LEVELS.map(fn(level) {
      return c[level]
    }),
  })
  let by_rule = {}
  for a in alerts {
    by_rule[a.rule] = by_rule.get(a.rule, 0) + 1
  }
  rule_chart.update({"labels": by_rule.keys(), "data": by_rule.values()})
  let per_hour = {}
  for r in records {
    if r.time != nil {
      let hour = hour_start(r.time)
      per_hour[hour] = per_hour.get(hour, 0) + 1
    }
  }
  let hours = hour_range(per_hour, 24)
  timeline.update({
    "labels": hours.map(fn(h) {
      return time.format(h, "%d %b %H:00")
    }),
    "data": hours.map(fn(h) {
      return per_hour.get(h, 0)
    }),
  })
}

# The start of the local hour t falls in (so 06:25 counts as 06:00 even in
# time zones that are not a whole number of hours from UTC).
fn hour_start(t) {
  let whole = int(t)
  return whole - int(time.format(whole, "%M")) * 60 - int(time.format(whole, "%S"))
}

# Every hour from the first to the last key of counts (at most `most`, the
# latest ones), so quiet hours show as 0 instead of being skipped.
fn hour_range(counts, most) {
  let keys = counts.keys().sort()
  if keys.is_empty() {
    return []
  }
  let last = keys.last()
  let h = keys.first()
  if h < last - (most - 1) * 3600 {
    h = hour_start(last - (most - 1) * 3600)
  }
  let hours = []
  while h <= last {
    hours.push(h)
    h = hour_start(h + 3600 + 1800)   # half an hour of slack keeps DST changes in step
  }
  return hours
}

fn time_span() {
  let timed = records.filter(fn(r) {
    return r.time != nil
  }).sort_by(fn(r) {
    return r.time
  })
  if timed.is_empty() {
    return "no timestamps"
  }
  return f"{timed.first().when} to {timed.last().when}"
}

# Extra notes an analyst wants for some alerts.
fn notes_for(alert) {
  let notes = []
  if alert.get("success_after", false) {
    notes.push(
      f"!! {alert.by} then logged in as {alert.success_user} at {alert.success_when}. Treat that account as compromised.",
    )
  }
  if alert.has("users") {
    notes.push("Accounts tried: " + alert.users.join(", "))
  }
  if alert.has("ports") {
    notes.push(f"Ports probed: {alert.ports.slice(0, 20).join(", ")}")
  }
  if alert.rule == "Encoded PowerShell command" {
    let m = re.match(
      "(?i)-(?:e|ec|enc|encodedcommand)\s+([A-Za-z0-9+/=]+)",
      alert.records[0].command_line,
    )
    if m != nil {
      notes.push("Decoded PowerShell: " + encode.unbase64(m[1]))
    }
  }
  return notes
}

fn show_details(i) {
  if i == nil {
    return
  }
  let a = alerts[i]
  let text = f"{a.level.upper()}  {a.rule}\n"
  text += f"By: {by_text(a)}    Count: {a.count}    From {a.first_when} to {a.last_when}\n"
  if a.get("description", "") != "" {
    text += a.description + "\n"
  }
  for note in notes_for(a) {
    text += note + "\n"
  }
  text += "\nSample log lines:\n"
  for r in a.records.slice(0, 8) {
    text += "  " + r.raw + "\n"
  }
  details.set(text)
}

fn open_log() {
  let path = gui.open_file(
    {"Logs": "*.log *.txt *.json *.jsonl *.csv", "All files": "*"},
    "Open a log",
  )
  if path != nil {
    load(path)
  }
}

fn export_report() {
  if current == nil {
    gui.alert("Open a log first.")
    return
  }
  let path = gui.save_file(f"triage-{fs.name(current)}.html", [".html"])
  if path == nil {
    return
  }
  let rows = []
  for a in alerts {
    rows.push({
      "level": a.level,
      "rule": a.rule,
      "by": by_text(a),
      "count": a.count,
      "first": a.first_when,
      "last": a.last_when,
    })
  }
  let c = level_counts()
  let page = report.html(f"TB Log Triage: {fs.name(current)}", rows, {
    "intro": f"{len(records)} records in {format} format, {time_span()}.",
    "stats": {
      "Records": len(records),
      "Alerts": len(alerts),
      "Critical": c.critical,
      "High": c.high,
    },
  })
  try {
    let saved = report.save(path, page)
    status.set(f"Report saved to {saved}")
  } catch err {
    gui.alert(err.message, "Couldn't save the report")
  }
}

load(start)
if SAMPLES.contains(fs.name(start)) {
  sample.set(fs.name(start))
}
win.run()
