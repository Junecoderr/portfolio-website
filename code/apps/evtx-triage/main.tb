# evtx-triage: read a binary Windows event log (.evtx) and triage it with the
# same detection rules log-triage uses on exported logs.
#
#   tb apps/evtx-triage/main.tb                       triage the sample log
#   tb apps/evtx-triage/main.tb Security.evtx         your own .evtx (copy it from
#                                                     C:\Windows\System32\winevt\Logs)
#   tb apps/evtx-triage/main.tb Security.evtx --html report.html --json events.jsonl

import os
import fs
import evtx
import report
import re
import encode
import "../log-triage/rules.tb"

let path = nil
let html_path = nil
let json_path = nil

let i = 0
while i < len(os.args) {
  let arg = os.args[i]
  if arg == "--html" or arg == "--json" {
    if i + 1 >= len(os.args) {
      say(f"{arg} needs a file name.")
      exit(2)
    }
    if arg == "--html" {
      html_path = os.args[i + 1]
    } else {
      json_path = os.args[i + 1]
    }
    i += 2
    continue
  }
  if arg == "--help" or arg == "-h" {
    say("Usage: tb main.tb [log.evtx] [--html report.html] [--json events.jsonl]")
    exit(0)
  }
  if arg.starts_with("--") {
    say(f"Unknown option {arg}. Try --help.")
    exit(2)
  }
  path = arg
  i += 1
}
if path == nil {
  path = fs.join(fs.here(), "..", "data", "sample.evtx")
  say("No log given, so here is a triage of apps/data/sample.evtx.")
  say("")
}

let info = nil
let records = nil
try {
  info = evtx.info(path)
  records = evtx.read(path)
} catch err {
  say(err.message)
  exit(1)
}
let summary = evtx.summary(records)

let health = "checksums ok"
if not info.checksums_ok {
  health = "CHECKSUM MISMATCH (damaged or tampered)"
}
if info.dirty {
  health += ", not closed cleanly"
}
say(
  f"== {fs.name(path)}  (EVTX {info.version}, {info.chunk_count} chunk(s), {summary.records} events, {health})",
)
say(f"   {summary.first_when} to {summary.last_when}")
let computers = []
for name in summary.computers.keys() {
  computers.push(f"{name} ({summary.computers[name]})")
}
say("   computers: " + computers.join(", "))
let channels = []
for name in summary.channels.keys() {
  channels.push(f"{name} ({summary.channels[name]})")
}
say("   channels: " + channels.join(", "))
if summary.broken > 0 {
  say(f"   !! {summary.broken} record(s) could not be decoded")
}
say("")

say("Events by type")
let type_rows = []
for id in summary.event_ids.keys() {
  let sample = records.filter(fn(r) {
    return r.event_id == id
  }).first()
  let what = sample.description
  if what == nil {
    what = "(no description for this event)"
  }
  type_rows.push({
    "event_id": id,
    "count": summary.event_ids[id],
    "action": sample.action,
    "description": what,
  })
}
say(report.table(type_rows, ["event_id", "count", "action", "description"], {"max_width": 60}))
say("")

# Notes an analyst would want next to some alerts (same as log-triage).
fn notes_for(alert) {
  let notes = []
  if alert.get("success_after", false) {
    notes.push(
      f"{alert.by} guessed a password: {alert.success_user} logged in at {alert.success_when}. Treat the account as compromised.",
    )
  }
  if alert.has("users") {
    notes.push("Accounts tried: " + alert.users.join(", "))
  }
  if alert.rule == "Encoded PowerShell command" {
    let cmd = alert.records[0].command_line
    let m = re.match("(?i)-(?:e|ec|enc|encodedcommand)\s+([A-Za-z0-9+/=]+)", cmd)
    if m != nil {
      notes.push("Decoded PowerShell: " + encode.unbase64(m[1]))
    }
  }
  return notes
}

let alerts = rules.triage(records)

# A few checks that only make sense for the binary log itself.
let extra = []
let installs = records.filter(fn(r) {
  return r.event_id == 7045
})
for r in installs {
  let image = r.get("ImagePath", "")
  if image != nil and
    (image.lower().contains("\\users\\") or
      image.lower().contains("\\temp\\") or
      image.lower().contains("\\programdata\\")) {
    extra.push({
      "level": "high",
      "rule": "Service installed from a user-writable folder",
      "by": r.get("ServiceName", "?"),
      "count": 1,
      "first_when": r.when,
      "last_when": r.when,
      "records": [r],
      "description": f"{r.get("ServiceName", "?")} runs {image}",
    })
  }
}
let sysmon = records.filter(fn(r) {
  return r.provider == "Microsoft-Windows-Sysmon" and r.event_id == 1
})
for r in sysmon {
  let image = r.get("Image", "")
  if image != nil and
    (image.lower().contains("\\temp\\") or image.lower().contains("\\downloads\\")) {
    extra.push({
      "level": "medium",
      "rule": "Program started from a Temp or Downloads folder",
      "by": r.user,
      "count": 1,
      "first_when": r.when,
      "last_when": r.when,
      "records": [r],
      "description": image,
    })
  }
}
alerts = alerts + extra
let order = {"critical": 0, "high": 1, "medium": 2, "low": 3, "informational": 4}
alerts = alerts.sort_by(fn(a) {
  return order[a.level]
})

say("Alerts")
if alerts.is_empty() {
  say("  Nothing matched the rules. This log looks quiet.")
} else {
  let rows = []
  for a in alerts {
    let by = a.by
    if by == nil {
      by = "-"
    }
    rows.push({
      "level": a.level,
      "rule": a.rule,
      "by": by,
      "count": a.count,
      "first": a.first_when,
      "last": a.last_when,
    })
  }
  say(report.table(rows, ["level", "rule", "by", "count", "first", "last"]))
  for a in alerts {
    for note in notes_for(a) {
      say("  * " + note)
    }
  }
}
say("")

let high = alerts.filter(fn(a) {
  return a.level == "high" or a.level == "critical"
})
if not high.is_empty() {
  say("Timeline of the high and critical alerts:")
  let events = []
  for a in high {
    for r in a.records {
      events.push(r)
    }
  }
  say(
    report.timeline(
      events.sort_by(fn(r) {
        return r.time
      }).unique(),
      {"limit": 25, "max_width": 150},
    ),
  )
  say("")
}

say(f"Done: {summary.records} events, {len(alerts)} alert(s), {len(high)} high or critical.")

if json_path != nil {
  let lines = []
  for r in records {
    lines.push(evtx.to_json(r))
  }
  try {
    fs.write(json_path, lines.join("\n") + "\n")
    say(f"Wrote {len(lines)} events as JSON lines to {json_path}")
  } catch err {
    say(err.message)
  }
}

if html_path != nil {
  let rows = []
  for a in alerts {
    rows.push({
      "level": a.level,
      "rule": a.rule,
      "by": a.by,
      "count": a.count,
      "first": a.first_when,
      "last": a.last_when,
    })
  }
  let page = report.html(f"EVTX triage: {fs.name(path)}", rows, {
    "intro": f"{summary.records} events from {summary.first_when} to {summary.last_when}; {health}.",
    "stats": {
      "Events": summary.records,
      "Alerts": len(alerts),
      "High": len(high),
      "Failures": summary.failures,
    },
    "sections": [
      {
        "title": "Events by type",
        "rows": type_rows,
        "columns": ["event_id", "count", "action", "description"],
      },
    ],
  })
  try {
    say("HTML report saved to " + report.save(html_path, page))
  } catch err {
    say(err.message)
  }
}
