# TB Alerts Dashboard: a SOC-style overview of one or more logs. Open logs
# (or pick the samples), TB runs the detection rules from apps/log-triage/
# rules.tb in the background and shows the alerts three ways: summary cards
# and charts, a tree grouped by level and rule, and a timeline of activity.
# Run: tb apps/alerts-dashboard-gui/main.tb [log files...] [--light] [--analyst NAME]

import gui
import logs
import report
import fs
import os
import time
import "../log-triage/rules.tb" as rules

let DATA = fs.join(fs.here(), "..", "data")
let SAMPLES = ["auth.log", "access.log", "firewall.log", "windows_security.json"]
let LEVELS = ["critical", "high", "medium", "low", "informational"]
let BADGE = {"critical": "danger", "high": "warning", "medium": "accent", "low": "info", "informational": "muted"}

let theme = "dark"
let analyst = "Tanisha"
let start = []
let i = 0
while i < len(os.args) {
  let arg = os.args[i]
  if arg == "--light" {
    theme = "light"
  } else if arg == "--dark" {
    theme = "dark"
  } else if arg == "--analyst" and i + 1 < len(os.args) {
    i += 1
    analyst = os.args[i]
  } else {
    start.push(arg)
  }
  i += 1
}
if start.is_empty() {
  start = [fs.join(DATA, "auth.log")]
}

let sources = []      # [{"path", "format", "records", "alerts"}]
let alerts = []       # every alert, most serious first
let records = []      # every record of every open log
let loading = 0

let win = gui.window("TB Alerts Dashboard", {"width": 1120, "height": 800, "theme": theme})

# -- header -----------------------------------------------------------------------

let head = win.row()
let titles = head.column({"expand": true})
titles.label("TB Alerts Dashboard", {"style": "title"})
let subtitle = titles.label(f"Analyst: {analyst}  ·  no logs open yet", {"style": "muted"})
let bar = win.row()
bar.button("Open logs…", fn() { open_logs() }, {"primary": true})
bar.label("or add a sample:", {"style": "muted"})
let sample = bar.select(["(choose)"] + SAMPLES, {"on_change": fn(name) {
  if name != "(choose)" {
    add_log(fs.join(DATA, name))
    sample.set("(choose)")
  }
}, "width": 24})
bar.button("Clear", fn() { clear_all() })
bar.button("Export HTML report…", fn() { export_report() })

# -- summary cards -------------------------------------------------------------------

let cards = win.row()
fn stat_card(title) {
  let card = cards.card({"title": title, "expand": true})
  return card.label("0", {"style": "display"})
}
let records_stat = stat_card("Records")
let alerts_stat = stat_card("Alerts")
let critical_stat = stat_card("Critical")
let high_stat = stat_card("High")
let logs_card = cards.card({"title": "Logs open", "expand": true})
let logs_stat = logs_card.label("0", {"style": "display"})
let level_badges = win.row()

# -- tabs -------------------------------------------------------------------------

let tabs = win.tabs(["Overview", "Alerts", "Timeline", "Sources"], {"expand": true})

let overview = tabs.page("Overview")
let charts = overview.row({"expand": true})
let level_chart = charts.chart({"type": "bar", "title": "Alerts by level", "labels": LEVELS,
                                "data": [0, 0, 0, 0, 0], "expand": true})
let rule_chart = charts.chart({"type": "pie", "title": "Alerts by rule", "empty": "No alerts yet", "expand": true})
let actor_chart = overview.chart({"type": "bar", "title": "Busiest sources (alerts by who did it)",
                                  "empty": "No alerts yet", "expand": true})

let alerts_page = tabs.page("Alerts")
let split = alerts_page.splitter({"expand": true})
let tree_pane = split.pane({"weight": 3})
let tree = tree_pane.tree(["Level / rule / who", "Count", "First seen", "Last seen"], {
  "widths": [360, 70, 170, 170], "on_select": fn(values, id) { show_alert(id) }, "expand": true,
})
let details_pane = split.pane({"weight": 2})
details_pane.label("Details", {"style": "heading"})
let details = details_pane.textarea({"readonly": true, "mono": true, "expand": true})
let tree_alert = {}   # tree node id -> alert

let timeline_page = tabs.page("Timeline")
let timeline = timeline_page.chart({"type": "line", "title": "Records and alerts per hour", "empty": "No timestamps yet",
                                    "expand": true})
let busiest = timeline_page.table(["Hour", "Records", "Alerts starting"], {"widths": [220, 100, 140], "height": 6})

let sources_page = tabs.page("Sources")
let sources_table = sources_page.table(["Log", "Format", "Records", "Alerts", "From", "To"],
                                       {"widths": [260, 100, 90, 70, 180, 180], "expand": true,
                                        "on_open": fn(row, i) { remove_source(i) }})
sources_page.label("Double-click a log to close it.", {"style": "muted"})

let status = win.status("Ready")

win.menu({
  "File": {
    "Open logs…": fn() { open_logs() },
    "Export HTML report…": fn() { export_report() },
    "-": nil,
    "Quit": win.close,
  },
  "View": {
    "Overview": fn() { tabs.select("Overview") },
    "Alerts": fn() { tabs.select("Alerts") },
    "Timeline": fn() { tabs.select("Timeline") },
  },
})
win.key("Mod+O", fn() { open_logs() })
win.key("Mod+E", fn() { export_report() })
win.on_drop(fn(paths) {
  for path in paths {
    add_log(path)
  }
})

# -- loading (in the background, so the window stays responsive) -----------------------

fn add_log(path) {
  for s in sources {
    if s.path == path {
      status.set(f"{fs.name(path)} is already open.")
      return
    }
  }
  loading += 1
  status.set(f"Reading {fs.name(path)}…")
  win.run_in_background(fn() {
    let fmt = logs.sniff(path)
    let got = logs.read(path)
    return {"path": path, "format": fmt, "records": got, "alerts": rules.triage(got)}
  }, fn(source) {
    loading -= 1
    sources.push(source)
    refresh()
    status.set(f"{fs.name(path)}: {len(source.records)} records, {len(source.alerts)} alerts")
  }, fn(message) {
    loading -= 1
    gui.alert(message, "Couldn't read the log")
    status.set("Ready")
  })
}

fn open_logs() {
  let path = gui.open_file({"Logs": "*.log *.txt *.json *.jsonl *.csv", "All files": "*"}, "Open a log")
  if path != nil {
    add_log(path)
  }
}

fn remove_source(i) {
  if i == nil {
    return
  }
  sources.remove_at(i)
  refresh()
}

fn clear_all() {
  sources = []
  refresh()
  status.set("Ready")
}

# -- putting it on screen ----------------------------------------------------------------

let ORDER = {"critical": 0, "high": 1, "medium": 2, "low": 3, "informational": 4}

fn by_text(alert) {
  if alert.by == nil {
    return "-"
  }
  return str(alert.by)
}

fn level_counts() {
  let found = {}
  for level in LEVELS {
    found[level] = 0
  }
  for a in alerts {
    found[a.level] += 1
  }
  return found
}

fn refresh() {
  alerts = []
  records = []
  for s in sources {
    for a in s.alerts {
      alerts.push(a)
    }
    for r in s.records {
      records.push(r)
    }
  }
  alerts = alerts.sort_by(fn(a) { return ORDER[a.level] * 10000000000 + (a.first or 0) })
  let c = level_counts()
  records_stat.set(len(records))
  alerts_stat.set(len(alerts))
  critical_stat.set(c.critical)
  high_stat.set(c.high)
  logs_stat.set(len(sources))
  level_badges.clear()
  for level in LEVELS {
    if c[level] > 0 {
      level_badges.badge(f"{c[level]} {level}", {"style": BADGE[level]})
    }
  }
  if sources.is_empty() {
    subtitle.set(f"Analyst: {analyst}  ·  no logs open yet")
  } else {
    subtitle.set(f"Analyst: {analyst}  ·  {len(sources)} log{plural(len(sources))}  ·  {len(records)} records  ·  {len(alerts)} alerts")
  }
  update_charts(c)
  update_tree()
  update_timeline()
  update_sources()
}

fn plural(n) {
  if n == 1 {
    return ""
  }
  return "s"
}

fn update_charts(c) {
  level_chart.update({"data": LEVELS.map(fn(level) { return c[level] })})
  let by_rule = {}
  let by_actor = {}
  for a in alerts {
    by_rule[a.rule] = by_rule.get(a.rule, 0) + 1
    let who = by_text(a)
    if who != "-" {
      by_actor[who] = by_actor.get(who, 0) + a.count
    }
  }
  rule_chart.update({"labels": by_rule.keys(), "data": by_rule.values()})
  let actors = by_actor.keys().sort_by(fn(k) { return 0 - by_actor[k] }).slice(0, 8)
  actor_chart.update({"labels": actors, "data": actors.map(fn(k) { return by_actor[k] })})
}

fn update_tree() {
  tree.clear()
  tree_alert = {}
  for level in LEVELS {
    let mine = alerts.filter(fn(a) { return a.level == level })
    if mine.is_empty() {
      continue
    }
    let level_node = tree.add(nil, [f"{level.upper()} ({len(mine)})", mine.map(fn(a) { return a.count }).sum()])
    let by_rule = {}
    for a in mine {
      if not by_rule.has(a.rule) {
        by_rule[a.rule] = []
      }
      by_rule[a.rule].push(a)
    }
    for rule in by_rule.keys() {
      let group = by_rule[rule]
      let rule_node = tree.add(level_node, [rule, group.map(fn(a) { return a.count }).sum(),
                                            group.first().first_when, group.last().last_when],
                               {"open": level == "critical" or level == "high"})
      for a in group {
        let node = tree.add(rule_node, [by_text(a), a.count, a.first_when, a.last_when])
        tree_alert[node] = a
      }
    }
  }
  details.set(if_text(alerts.is_empty(), "No alerts. Open a log to start.", "Pick an alert in the tree."))
}

fn if_text(cond, a, b) {
  if cond {
    return a
  }
  return b
}

fn show_alert(id) {
  if not tree_alert.has(id) {
    return
  }
  let a = tree_alert[id]
  let text = f"{a.level.upper()}  {a.rule}\n"
  text += f"By: {by_text(a)}    Count: {a.count}    From {a.first_when} to {a.last_when}\n"
  if a.get("description", "") != "" {
    text += a.description + "\n"
  }
  if a.get("success_after", false) {
    text += f"!! {a.by} then logged in as {a.success_user} at {a.success_when}. Treat that account as compromised.\n"
  }
  if a.has("users") {
    text += "Accounts tried: " + a.users.join(", ") + "\n"
  }
  if a.has("ports") {
    text += f"Ports probed: {a.ports.slice(0, 20).join(", ")}\n"
  }
  text += "\nSample log lines:\n"
  for r in a.records.slice(0, 8) {
    text += "  " + r.raw + "\n"
  }
  details.set(text)
}

# The start of the local hour t falls in (so 06:25 counts as 06:00 even in
# time zones that are not a whole number of hours from UTC).
fn hour_start(t) {
  let whole = int(t)
  return whole - int(time.format(whole, "%M")) * 60 - int(time.format(whole, "%S"))
}

# Every hour from the first to the last key of counts (at most `most`, the
# latest ones), so quiet hours show as 0 instead of being skipped.
fn hour_range(counts, most) {
  let keys = counts.keys().sort()
  if keys.is_empty() {
    return []
  }
  let last = keys.last()
  let h = keys.first()
  if h < last - (most - 1) * 3600 {
    h = hour_start(last - (most - 1) * 3600)
  }
  let hours = []
  while h <= last {
    hours.push(h)
    h = hour_start(h + 3600 + 1800)   # half an hour of slack keeps DST changes in step
  }
  return hours
}

fn update_timeline() {
  let per_hour = {}
  let alerts_per_hour = {}
  for r in records {
    if r.time != nil {
      let h = hour_start(r.time)
      per_hour[h] = per_hour.get(h, 0) + 1
    }
  }
  for a in alerts {
    if a.first != nil {
      let h = hour_start(a.first)
      alerts_per_hour[h] = alerts_per_hour.get(h, 0) + 1
    }
  }
  let hours = hour_range(per_hour, 36)
  let labels = hours.map(fn(h) { return time.format(h, "%d %b %H:00") })
  timeline.update({"labels": labels, "data": {
    "records": hours.map(fn(h) { return per_hour.get(h, 0) }),
    "alerts": hours.map(fn(h) { return alerts_per_hour.get(h, 0) }),
  }})
  let top = per_hour.keys().sort_by(fn(h) { return 0 - per_hour[h] }).slice(0, 10)
  busiest.set_rows(top.map(fn(h) { return [time.format(h, "%Y-%m-%d %H:00"), per_hour[h], alerts_per_hour.get(h, 0)] }))
}

fn span(recs) {
  let timed = recs.filter(fn(r) { return r.time != nil }).sort_by(fn(r) { return r.time })
  if timed.is_empty() {
    return ["-", "-"]
  }
  return [timed.first().when, timed.last().when]
}

fn update_sources() {
  sources_table.set_rows(sources.map(fn(s) {
    let when = span(s.records)
    return [fs.name(s.path), s.format, len(s.records), len(s.alerts), when[0], when[1]]
  }))
}

fn export_report() {
  if alerts.is_empty() and sources.is_empty() {
    gui.alert("Open a log first.")
    return
  }
  let path = gui.save_file("alerts-dashboard.html", [".html"])
  if path == nil {
    return
  }
  let rows = alerts.map(fn(a) {
    return {"level": a.level, "rule": a.rule, "by": by_text(a), "count": a.count,
            "first": a.first_when, "last": a.last_when}
  })
  let c = level_counts()
  let page = report.html("TB Alerts Dashboard", rows, {
    "intro": f"Prepared by {analyst}: {len(sources)} log{plural(len(sources))}, {len(records)} records, {len(alerts)} alerts.",
    "stats": {"Logs": len(sources), "Records": len(records), "Alerts": len(alerts), "Critical": c.critical, "High": c.high},
  })
  try {
    status.set(f"Report saved to {report.save(path, page)}")
  } catch err {
    gui.alert(err.message, "Couldn't save the report")
  }
}

refresh()
for path in start {
  add_log(path)
}
win.run()
