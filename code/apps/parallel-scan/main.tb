# parallel-scan: check TCP ports on several hosts at once, and see how much
# faster that is than one at a time.
#
#   tb main.tb                              this computer (127.0.0.1), common ports
#   tb main.tb 127.0.0.1,localhost 22,80,8000-8010
#   tb main.tb 127.0.0.1 1-200 --workers 32
#   tb main.tb --latency 50                 pretend every check takes 50 ms more
#   tb main.tb 192.168.1.20 --authorised    another machine you own
#
# Only check computers you own or have written permission to test.
# Checking other people's systems can be against the law.

import os
import net
import text
import time
import parallel

fn usage() {
  say(
    "Usage: tb main.tb [HOSTS] [PORTS] [--workers N] [--timeout SECONDS] [--no-compare] [--authorised]",
  )
  say("  HOSTS    comma-separated, default 127.0.0.1 (this computer)")
  say("  PORTS    like 22,80,443 or 8000-8010 (default: common ports)")
  say("  --workers N        how many checks run at once (default 16)")
  say("  --timeout S        seconds to wait for each port (default 0.5)")
  say("  --no-compare       skip the one-at-a-time run used for the timing comparison")
  say("  --latency MS       add MS milliseconds to every check, like a slow network")
  say("  --authorised       needed for hosts other than this computer:")
  say("                     you confirm you own them or have written permission.")
}

let hosts = ["127.0.0.1"]
let port_text = nil
let workers = 16
let timeout = 0.5
let latency = 0
let compare = true
let authorised = false
let positional = []
let i = 0
while i < len(os.args) {
  let a = os.args[i]
  if a == "--help" or a == "-h" {
    usage()
    exit(0)
  } else if a == "--workers" or a == "--timeout" or a == "--latency" {
    if i + 1 >= len(os.args) {
      say(f"{a} needs a number after it.")
      exit(2)
    }
    let value = num(os.args[i + 1])
    if a == "--workers" {
      workers = int(value)
    } else if a == "--latency" {
      latency = value
    } else {
      timeout = value
    }
    i += 1
  } else if a == "--no-compare" {
    compare = false
  } else if a == "--authorised" or a == "--authorized" {
    authorised = true
  } else {
    positional.push(a)
  }
  i += 1
}
if len(positional) > 0 {
  hosts = positional[0].split(",").map(h => h.trim()).filter(h => h != "")
}
if len(positional) > 1 {
  port_text = positional[1]
}

# The ports to check, as a list of numbers ("22,80,8000-8010" or the common ones).
fn parse_ports(spec) {
  if spec == nil {
    return sorted(keys(net.common_ports))
  }
  let ports = []
  for part in spec.split(",") {
    let bits = part.trim().split("-")
    let low = int(num(bits[0]))
    let high = low
    if len(bits) > 1 {
      high = int(num(bits[1]))
    }
    for p in low..=high {
      if p < 1 or p > 65535 {
        throw ValueError(f"{p} isn't a port number (1 to 65535).")
      }
      if not ports.contains(p) {
        ports.push(p)
      }
    }
  }
  return ports
}

let ports = []
try {
  ports = parse_ports(port_text)
} catch err {
  say(f"I couldn't read the ports '{port_text}': {err.message}")
  exit(2)
}

# Anything that isn't this computer needs an explicit promise that it's allowed.
for host in hosts {
  let mine = host == "localhost" or (net.is_ip(host) and net.is_loopback(host))
  if not mine and not authorised {
    say(f"{host} isn't this computer.")
    say("Only check machines you own or have written permission to test.")
    say("If that's the case, run again with --authorised.")
    exit(2)
  }
}

# One job per (host, port) pair.
let jobs = []
for host in hosts {
  for port in ports {
    jobs.push({"host": host, "port": port})
  }
}

fn check(job) {
  if latency > 0 {
    parallel.sleep(latency / 1000)
  }
  try {
    return net.tcp_check(job.host, job.port, timeout)
  } catch err {
    return false  # a name that doesn't resolve counts as closed
  }
}

say(f"Checking {len(jobs)} ports on {len(hosts)} host(s) with {workers} workers...")

let start = time.timestamp()
let results = parallel.map(check, jobs, workers)
let parallel_time = time.timestamp() - start

let sequential_time = nil
if compare {
  start = time.timestamp()
  let again = jobs.map(check)
  sequential_time = time.timestamp() - start
}

say("")
say(f"{text.pad_right("HOST", 18)}{text.pad_right("PORT", 7)}{text.pad_right("SERVICE", 15)}STATE")
let open_count = 0
for k in range(len(jobs)) {
  if results[k] {
    open_count += 1
    let job = jobs[k]
    let service = net.common_ports.get(job.port, "")
    say(
      f"{text.pad_right(job.host, 18)}{text.pad_right(job.port, 7)}{text.pad_right(service, 15)}OPEN",
    )
  }
}
if open_count == 0 {
  say("(nothing open)")
}
say("")
say(f"{open_count} open, {len(jobs) - open_count} closed or filtered.")
say(f"parallel ({workers} workers): {format(parallel_time, ".3f")}s")
if sequential_time != nil {
  say(f"one at a time:       {format(sequential_time, ".3f")}s")
  if parallel_time > 0 {
    say(f"speed-up:            {format(sequential_time / parallel_time, ".1f")}x")
  }
}
