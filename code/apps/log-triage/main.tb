# log-triage: read log files, run detections, and show what needs attention.
#
#   tb apps/log-triage/main.tb                      triage every sample log
#   tb apps/log-triage/main.tb /var/log/auth.log    triage your own log
#   tb apps/log-triage/main.tb access.log --html report.html

import os
import fs
import logs
import report
import encode
import re
import "rules.tb"

let data = fs.join(fs.here(), "..", "data")
let files = []
let html_path = nil

let i = 0
while i < len(os.args) {
  let arg = os.args[i]
  if arg == "--html" {
    if i + 1 >= len(os.args) {
      say("--html needs a file name, like: --html report.html")
      exit(2)
    }
    html_path = os.args[i + 1]
    i += 2
    continue
  }
  if arg == "--help" or arg == "-h" {
    say("Usage: tb main.tb [log ...] [--html report.html]")
    exit(0)
  }
  if arg.starts_with("--") {
    say(f"Unknown option {arg}. Usage: tb main.tb [log ...] [--html report.html]")
    exit(2)
  }
  files.push(arg)
  i += 1
}
if files.is_empty() {
  for name in [
    "auth.log",
    "access.log",
    "firewall.log",
    "windows_security.json",
    "windows_security.csv",
  ] {
    files.push(fs.join(data, name))
  }
  say("No log given, so here is a triage of the sample logs in apps/data.")
  say("")
}

# The time span a list of records covers, as text.
fn span(records) {
  let timed = records.filter(fn(r) {
    return r.time != nil
  }).sort_by(fn(r) {
    return r.time
  })
  if timed.is_empty() {
    return "no timestamps"
  }
  return f"{timed.first().when} to {timed.last().when}"
}

# Notes an analyst would want next to some alerts.
fn notes_for(alert) {
  let notes = []
  if alert.get("success_after", false) {
    notes.push(
      f"{alert.by} guessed a password: {alert.success_user} logged in at {alert.success_when}. Treat the account as compromised.",
    )
  }
  if alert.rule == "Encoded PowerShell command" {
    let cmd = alert.records[0].command_line
    let m = re.match("(?i)-(?:e|ec|enc|encodedcommand)\s+([A-Za-z0-9+/=]+)", cmd)
    if m != nil {
      notes.push("Decoded PowerShell: " + encode.unbase64(m[1]))
    }
  }
  if alert.rule == "Port scan" {
    notes.push(f"{alert.by} probed {alert.count} ports: {alert.ports.slice(0, 12).join(", ")}...")
  }
  return notes
}

let all_alerts = []
let total_records = 0
let files_read = 0
for path in files {
  let records = []
  try {
    records = logs.read(path)
  } catch err {
    say(f"Skipping {path}: {err.message}")
    continue
  }
  files_read += 1
  total_records += len(records)
  let format = "empty"
  if not records.is_empty() {
    format = records[0].format
  }
  say(f"== {fs.name(path)}  ({format}, {len(records)} records, {span(records)})")

  let busiest = logs.top(records, "ip", 3).map(fn(t) {
    return f"{t.value} ({t.count})"
  })
  if not busiest.is_empty() {
    say("   busiest IPs: " + busiest.join(", "))
  }

  let alerts = rules.triage(records)
  if alerts.is_empty() {
    say("   No alerts. Nothing matched the rules.")
    say("")
    continue
  }
  for a in alerts {
    a.log = fs.name(path)
    all_alerts.push(a)
  }
  say(
    report.table(alerts, ["level", "rule", "by", "count", "first_when", "last_when"], {
      "max_width": 36,
    }),
  )
  for a in alerts {
    for note in notes_for(a) {
      say("   ! " + note)
    }
  }
  say("")
}

if files_read == 0 {
  say("None of the logs could be read, so there is nothing to triage.")
  exit(1)
}

let serious = all_alerts.filter(fn(a) {
  return a.level == "critical" or a.level == "high"
})
say(
  f"Done: {total_records} records in {files_read} file(s), {len(all_alerts)} alert(s), {len(serious)} high or critical.",
)

if not serious.is_empty() {
  say("")
  say("Timeline of the high and critical alerts:")
  say(report.timeline(serious))
}

if html_path != nil {
  let page = report.html("Log triage", all_alerts, {
    "columns": ["level", "rule", "by", "count", "first_when", "last_when", "log"],
    "intro": f"{len(files)} log file(s), {total_records} records. Alerts are sorted by level, then time.",
    "stats": {
      "records": total_records,
      "alerts": len(all_alerts),
      "high or critical": len(serious),
    },
  })
  say("")
  say("HTML report saved to " + report.save(html_path, page))
}
