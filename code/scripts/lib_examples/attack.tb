import attack

let t = attack.technique("T1110.003")
say(f"{t.id} {t.full_name} ({t.tactics.join(', ')})")
say(t.url)

for found in attack.search("kerberos", 3) {
  say(f"{found.id}  {found.full_name}")
}

# Alerts carry Sigma tags like attack.t1110.001; map() groups them by tactic.
let alerts = [{"rule": "SSH brute force", "level": "high", "tags": ["attack.t1110.001"]}]
for tactic in attack.map(alerts).tactics {
  say(f"{tactic.name}: {tactic.techniques}")
}
say(attack.info().snapshot)
