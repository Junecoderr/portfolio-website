import binary
import elf

# A tiny 64-bit Linux program, built byte by byte: the ELF header, one
# program header (a loadable, runnable segment) and ten bytes of code.
let data = binary.concat(
  b"\x7fELF",
  binary.pack("<BBBB", 2, 1, 1, 0),
  binary.zeros(8),
  binary.pack("<HHIQQQIHHHHHH", 2, 62, 1, 0x401000, 64, 0, 0, 64, 56, 1, 64, 0, 0),
  binary.pack("<IIQQQQQQ", 1, 5, 0, 0x400000, 0x400000, 130, 130, 0x1000),
  b"\x48\x31\xff\xb8\x3c\x00\x00\x00\x0f\x05",
)

let info = elf.parse_bytes(data)
say(f"{info.format} {info.type} for {info.architecture}, entry {info.entry_hex}")
for seg in info.segments {
  say(f"  segment {seg.type}: {seg.file_size} bytes, {seg.flags.join("+")}")
}
for hit in elf.indicators(info) {
  say(f"  [{hit.level}] {hit.detail}")
}
