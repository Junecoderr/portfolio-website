# Title: Hello, world
# About: Your very first TB program. It says hello and does a little maths.

# Lines that start with # are notes for people. TB skips them.

say("Hello, world!")
say("Hello, Sam!")

# say() can show more than one thing at once, with spaces in between.
say("Two plus two is", 2 + 2)

# Text in quotes can be joined together with +
let name = "Priya"
say("Welcome to TB, " + name + ".")
