# Title: Love buzz
# About: A playful pattern: every 3rd number says "love", every 5th says "hugs".

# % gives the remainder after dividing. If n % 3 is 0, n is a multiple of 3.
for n in range(1, 16) {
  if n % 15 == 0 {
    say("love and hugs!")
  } else if n % 3 == 0 {
    say("love")
  } else if n % 5 == 0 {
    say("hugs")
  } else {
    say(n)
  }
}
say("")

# Text times a number repeats the text. Here we draw a little heart triangle.
for size in range(1, 6) {
  say("<3 " * size)
}
