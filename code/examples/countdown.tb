# Title: Countdown to lift-off
# About: Counts down with a while loop, then counts by twos with range().

let seconds = 5
say("Lift-off in...")
while seconds > 0 {
  say(str(seconds) + "...")
  seconds = seconds - 1
}
say("Lift-off! The rocket is away.")
say("")

# range(10, 0, -2) means: start at 10, stop before 0, go down 2 each time.
say("Counting by twos, backwards:")
for n in range(10, 0, -2) {
  say(n)
}
