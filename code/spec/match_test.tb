# Conformance: §10 patterns.

import test

class Alert {
  fn init(name, level) {
    self.name = name
    self.level = level
  }
}

enum Level { low, high }

fn label(value) {
  return match value {
    "critical" or "high" => "act now"
    n if n is number and n > 7 => f"score {n}"
    [first, ...rest] => f"starts with {first}"
    {"kind": "alert", "level": lv} => lv
    1..=5 => "low range"
    Level.low => "enum low"
    Alert(a) => a.name
    is text => "some text"
    _ => "unknown"
  }
}

test.case("§10 every kind of pattern", fn() {
  test.equal(label("high"), "act now")
  test.equal(label(9), "score 9")
  test.equal(label([1, 2]), "starts with 1")
  test.equal(label({"kind": "alert", "level": 3, "extra": true}), 3)
  test.equal(label(5), "low range")
  test.equal(label(Level.low), "enum low")
  test.equal(label(Alert("Brute force", 3)), "Brute force")
  test.equal(label("other"), "some text")
  test.equal(label(nil), "unknown")
})

test.case("§10 lists, maps, classes and ranges", fn() {
  let exact = match [1, 2] {
    [a] => "one"
    [a, b] => "two"
    _ => "many"
  }
  test.equal(exact, "two")
  let any_rest = match [1, 2, 3] {
    [first, ...] => first
  }
  test.equal(any_rest, 1)
  let short = match {"name": "Tanisha"} {
    {name} => name
  }
  test.equal(short, "Tanisha")
  let fields = match Alert("x", 3) {
    Alert {level: 3} => "three"
    _ => "?"
  }
  test.equal(fields, "three")
  let ranges = match 3 {
    1..3 => "below"
    3..=4 => "three or four"
    _ => "no"
  }
  test.equal(ranges, "three or four")
  let neg = match -3 {
    -3 => "minus three"
    _ => "?"
  }
  test.equal(neg, "minus three")
})

test.case("§10 a bare name always binds", fn() {
  const K = 3
  let v = match 4 {
    K => K
    _ => "other"
  }
  test.equal(v, 4)
})

test.case("§10 or alternatives need not bind the same names", fn() {
  let v = match 5 {
    [a] or b => b
    _ => 0
  }
  test.equal(v, 5)
})

test.case("§10 block arms and statements", fn() {
  let v = match 2 {
    1 => "one"
    2 => {
      let t = "two"
      t
    }
  }
  test.equal(v, "two")
  let seen = []
  match "x" {
    "x" => seen.push("matched")
    _ => nil
  }
  test.equal(seen, ["matched"])
})

test.case("§10 no arm fits", fn() {
  test.raises(fn() {
    let v = match 3 {
      1 => "one"
    }
  }, "Nothing in this match fits 3")
})
