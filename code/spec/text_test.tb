# Conformance: §3.2 text, lists and bytes.

import test

test.case("§3.2 indexing and slicing text", fn() {
  let s = "hello"
  test.equal(s[0], "h")
  test.equal(s[-1], "o")
  test.equal(s[1:3], "el")
  test.equal(s[::-1], "olleh")
  test.equal(s[::2], "hlo")
  test.equal("hi"[5:9], "")
  test.raises(() => "hi"[5], "outside the text")
})

test.case("§3.2 text can't change in place", fn() {
  test.raises(fn() {
    import "support/bad/text_change.tbx" as bad
  }, "can't be changed")
})

test.case("§3.2 repetition", fn() {
  test.equal("ab" * 2, "abab")
  test.equal([1, 2] * 2, [1, 2, 1, 2])
  test.raises(() => "x" * -1)
})

test.case("§3.2 bytes", fn() {
  let data = b"abc"
  test.equal(type(data), "bytes")
  test.equal(data[0], 97)
  test.equal(data + b"d", b"abcd")
  test.equal(data.hex(), "616263")
  test.equal(b"hi".to_text(), "hi")
  test.equal("é".bytes().len(), 2)
  test.true(b"b" in data)
  let seen = []
  for byte in b"AB" {
    seen.push(byte)
  }
  test.equal(seen, [65, 66])
})

test.case("§4 in", fn() {
  test.true("abc" in "xabcx")
  test.true(2 in {2: "x"})
  test.true(3 in 1..5)
  test.false(5 in 0..5)
})
