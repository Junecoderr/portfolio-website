# Conformance: §3 lists, maps, ranges and equality.

import test

test.case("§3 type names", fn() {
  test.equal([type(nil), type(true), type([]), type({}), type(b""), type(""), type(1..2)], [
    "nil",
    "bool",
    "list",
    "map",
    "bytes",
    "text",
    "range",
  ])
  test.equal(type(say), "function")
  test.equal(type(done), "done")
})

test.case("§3 truthiness", fn() {
  test.true(if 0 then true else false)
  test.true(if "" then true else false)
  test.true(if [] then true else false)
  test.false(if nil then true else false)
})

test.case("§3 equality", fn() {
  test.true(1 == 1.0)
  test.false(1 == "1")
  test.false(nil == false)
  test.true([1, [2]] == [1, [2]])
  test.true({"a": 1} == {"a": 1})
  test.true(1..3 == 1..3)
})

test.case("§3 map keys are text or numbers", fn() {
  let m = {"b": 1, "a": 2}
  test.equal(m.keys(), ["b", "a"])
  test.raises(fn() {
    m[[1]] = 2
  }, "Map keys")
})

test.case("§3 ranges", fn() {
  test.equal((0..3).to_list(), [0, 1, 2])
  test.equal((1..=3).to_list(), [1, 2, 3])
  test.equal((1..10).step(3).to_list(), [1, 4, 7])
  test.equal(len(1..=5), 5)
  test.equal((0..10)[2], 2)
})

test.case("§4 spread", fn() {
  let m = {"a": 1}
  test.equal({...m, "b": 2}, {"a": 1, "b": 2})
  test.equal({...m, "a": 5}, {"a": 5})
  test.equal([...[1], ...[2, 3]], [1, 2, 3])
  fn add(a, b, c) {
    return a + b + c
  }
  test.equal(add(...[1, 2, 3]), 6)
})

test.case("§3.2 list slices and negative indexes", fn() {
  let xs = [1, 2, 3, 4]
  test.equal(xs[-1], 4)
  test.equal(xs[1:], [2, 3, 4])
  test.equal(xs[::2], [1, 3])
  test.equal(xs[-2:], [3, 4])
  xs[0] = 9
  test.equal(xs[0], 9)
  test.raises(() => xs[9], "outside the list")
})
