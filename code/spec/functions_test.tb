# Conformance: §6 functions.

import test

test.case("§6 defaults, rest and named arguments", fn() {
  fn greet(name, greeting = "Hello", ...rest) {
    return f"{greeting}, {name}{rest.join("")}"
  }
  test.equal(greet("Tanisha"), "Hello, Tanisha")
  test.equal(greet("Tanisha", greeting = "Hi"), "Hi, Tanisha")
  test.equal(greet("Tanisha", "Hey", "!", "!"), "Hey, Tanisha!!")
  fn add(a, b = a * 2) {
    return a + b
  }
  test.equal(add(1), 3)
  fn opts(a, **more) {
    return more
  }
  test.equal(opts(1, b = 2, c = 3), {"b": 2, "c": 3})
})

test.case("§6 argument mistakes", fn() {
  test.raises(fn() {
    import "support/bad/arg_twice.tbx" as bad
  }, "twice")
  test.raises(fn() {
    import "support/bad/arg_missing.tbx" as bad
  }, "needs 1 input")
  test.raises(fn() {
    import "support/bad/arg_extra.tbx" as bad
  }, "needs 1 input")
  test.raises(fn() {
    import "support/bad/arg_unknown.tbx" as bad
  }, "no input called 'b'")
  test.raises(fn() {
    import "support/bad/named_then_positional.tbx" as bad
  }, "must come after")
})

test.case("§6 lambdas", fn() {
  let double = x => x * 2
  let add = (a, b) => a + b
  let one = () => 1
  let block = x => {
    let y = x + 1
    return y
  }
  let no_return = x => {
    x + 1
  }
  test.equal([double(2), add(1, 2), one(), block(1), no_return(1)], [4, 3, 1, 2, nil])
})

test.case("§6 closures capture variables", fn() {
  let x = 10
  let f = () => x
  x = 20
  test.equal(f(), 20)
  fn counter() {
    let c = 0
    return () => {
      c += 1
      return c
    }
  }
  let next = counter()
  next()
  test.equal(next(), 2)
})

test.case("§6 function values", fn() {
  fn named(a, b = 2) {
    return a - b
  }
  test.equal(named.name, "named")
  test.equal(named.arity, 2)
  test.equal((x => x).name, "anonymous")
  test.equal(
    fn(x) {
      return x
    }.name,
    "anonymous",
  )
  test.equal(named.call([5, 1]), 4)
  test.equal(named.bind(10)(3), 7)
  test.equal(say.name, "say")
})

test.case("§6 type annotations are ignored when running", fn() {
  fn h(a: text, b: list<number> = []) -> text | nil {
    return a
  }
  let n: number = 4
  test.equal(h("x"), "x")
  test.equal(n, 4)
})

test.case("§6 recursion depth is limited", fn() {
  fn forever(n) {
    return forever(n + 1)
  }
  test.raises(() => forever(0), "too many times")
})
